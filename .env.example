# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Path of the SQLite database file (default: data/bizcontrol.sqlite)
DB_PATH=data/bizcontrol.sqlite
# Set to true when served over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
# Set to true when behind a reverse proxy (nginx/Caddy) that sets X-Forwarded-* headers
TRUST_PROXY=false
# Public URL of the app (used in password-reset links & WhatsApp webhook URL display)
BASE_URL=http://localhost:3000

# ---- WhatsApp Business Cloud API (see docs/WHATSAPP_SETUP.md) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---- Email notifications (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ssl = implicit TLS (465), starttls = upgrade (587), none = plain (local relay only)
SMTP_SECURITY=starttls

# ---- Optional AI analysis (Anthropic API) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# =====================================================================
# HOSTED SERVICE (multi-customer). Setting APP_DOMAIN turns it on.
# Everything below is explained in docs/LAUNCH_GUIDE.md
# =====================================================================
# Your domain. Marketing site = APP_DOMAIN, admin = admin.APP_DOMAIN, customers = <name>.APP_DOMAIN
APP_DOMAIN=
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=
PLATFORM_NAME=BizControl
PLATFORM_LEGAL_NAME=
PLATFORM_ADDRESS=
PLATFORM_TAX_ID=
SUPPORT_EMAIL=
ALERT_EMAIL=
# 32 random bytes, hex. LOSING THIS KEY MAKES STORED INTEGRATION SECRETS AND BACKUPS UNREADABLE. Back it up somewhere safe.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# After rotating the key, put the previous key(s) here (comma separated) until everything is re-encrypted
APP_ENCRYPTION_KEY_OLD=
CONTROL_DB_PATH=data/control.sqlite
TENANTS_DIR=data/tenants
TENANT_POOL_MAX=200
# How many devices may be signed in to one login at once (admin can override per customer). 1 = no sharing.
SESSION_LIMIT=1
DEMO_ENABLED=true
# Emails sent BY THE PLATFORM (verification, receipts, reminders)
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASS=
PLATFORM_SMTP_FROM=
PLATFORM_SMTP_SECURITY=starttls
# Optional: Cloudflare Turnstile bot check on sign-up
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Bank / Whish / OMT payment instructions shown to customers who pay manually
MANUAL_PAYMENT_INSTRUCTIONS=
# Card payments (Paddle) - leave empty until you finish the Paddle step in docs/LAUNCH_GUIDE.md
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Monitoring (all optional)
METRICS_TOKEN=
SENTRY_DSN=
# Backups: encrypted daily copy of every workspace. Optional S3-compatible storage (Backblaze B2, Cloudflare R2, AWS S3, MinIO)
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
