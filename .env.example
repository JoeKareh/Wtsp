# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Path of the SQLite database file (default: data/bizcontrol.sqlite)
DB_PATH=data/bizcontrol.sqlite
# Set to true when served over HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
# Set to true when behind a reverse proxy (nginx/Caddy) that sets X-Forwarded-* headers
TRUST_PROXY=false
# Public URL of the app (used in password-reset links & WhatsApp webhook URL display)
BASE_URL=http://localhost:3000

# ---- WhatsApp Business Cloud API (see docs/WHATSAPP_SETUP.md) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---- Email notifications (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ssl = implicit TLS (465), starttls = upgrade (587), none = plain (local relay only)
SMTP_SECURITY=starttls

# ---- Optional AI analysis (Anthropic API) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
